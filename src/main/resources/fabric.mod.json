{
  "schemaVersion": 1,
  "id": "cesium",
  "version": "${version}",
  "name": "Cesium",
  "description": "Advanced client-side network optimizer for lower ping and smoother gameplay",
  "authors": [
    "AtomGamer"
  ],
  "contact": {
    "homepage": "https://github.com/AtomGamer/cesium",
    "sources": "https://github.com/AtomGamer/cesium",
    "issues": "https://github.com/AtomGamer/cesium/issues"
  },
  "license": "LGPL-3.0",
  "icon": "assets/cesium/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.cesium.CesiumMod"
    ],
    "modmenu": [
      "net.cesium.compat.ModMenuIntegration"
    ],
    "fabric-command-api-v2": [
      "net.cesium.command.CesiumCommand"
    ]
  },
  "mixins": [
    "cesium.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~1.21",
    "java": ">=21"
  },
  "suggests": {
    "fabric-api": "*",
    "modmenu": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/atomsmp"
      }
    }
  }
}
